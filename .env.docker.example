# Copy to .env in the project root (gitignored).
# docker compose reads this file for both production and dev.

# Auth / main API (browser must be able to reach this URL)
REACT_APP_API_BASE_URL=http://localhost:0000

# Scheduler API (local food-packaging-quarkus: mvn quarkus:dev -Dquarkus.profile=local)
REACT_APP_API_SCHEDULER_URL=http://localhost:8080

# Optional label shown in the UI
REACT_APP_PRODUCTION_BRANCH_NAME=local

# Host port for the production nginx container (docker compose up)
FRONTEND_PORT=80
